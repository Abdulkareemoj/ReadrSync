VITE_SERVER_URL=http://localhost:5173

# ── Mobile (Expo) ─────────────────────────────────────
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Desktop (Vite) — "Desktop" OAuth client type ─────
# No redirect URI registration needed — Google auto-accepts localhost
VITE_GOOGLE_DESKTOP_CLIENT_ID=
# Client secret is optional for "Desktop" type (not used by Rust exchange)
# VITE_GOOGLE_DESKTOP_SECRET_ID=

# ── Web (Vite) — "Web" OAuth client type ──────────────
# Used for web app OAuth (PKCE flow).
# Authorized redirect URIs (register in Google Cloud Console):
#   http://localhost:3000/auth/callback  (dev)
#   <production-url>/auth/callback       (prod)
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_WEB_SECRET_ID=